# Doxygen configuration for VisVU project
# Generated on 2026-01-07

# Project identity
PROJECT_NAME           = "Fast Compressed Segmentation Volumes (VisVU)"
PROJECT_BRIEF          = "Encoder (C++) + WebGPU renderer (JavaScript + WGSL)"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/build
CREATE_SUBDIRS         = NO

# Input selection
INPUT                  = README.md \
                         docs/index.md \
                         encoder/CSVEncoder/src \
                         web/app.js \
                         web/scripts \
                         web/shaders
FILE_PATTERNS          = *.md \
                         *.c *.cpp *.h *.hpp \
                         *.js \
                         *.wgsl
RECURSIVE              = YES
EXCLUDE                = encoder/bin \
                         encoder/bin-int

# Treat unsupported extensions as C++ for parsing structure
EXTENSION_MAPPING      = wgsl=C++
# FILTER_PATTERNS        = *.wgsl="python tools/wgsl_doxygen_filter.py"  # Disabled - may cause stalls

# Extraction options
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# Documentation style helpers
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_FOR_FORTRAN   = NO
OPTIMIZE_OUTPUT_VHDL   = NO
OPTIMIZE_OUTPUT_SLICE  = NO

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# Diagrams (keep dot off unless installed)
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# Outputs
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

# Markdown
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/index.md

# Warnings
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           =

# Misc
ALIASES                = "shader=\par Shader" \
                         "wgsl=\par WGSL"
